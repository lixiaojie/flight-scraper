# 开发模式后端Dockerfile - 使用本地依赖缓存
FROM python:3.11-slim

WORKDIR /app

# 配置国内APT源
RUN echo "deb https://mirrors.ustc.edu.cn/debian/ bookworm main" > /etc/apt/sources.list && \
    echo "deb https://mirrors.ustc.edu.cn/debian/ bookworm-updates main" >> /etc/apt/sources.list && \
    echo "deb https://mirrors.ustc.edu.cn/debian-security/ bookworm-security main" >> /etc/apt/sources.list

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements*.txt ./

# 配置pip国内源
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 使用本地缓存安装Python依赖（如果存在）
RUN if [ -d "/cache/venv" ]; then \
        cp -r /cache/venv ./venv; \
        ./venv/bin/pip install --no-cache-dir -r requirements-dev.txt; \
    else \
        python -m venv venv; \
        ./venv/bin/pip install --no-cache-dir -r requirements-dev.txt; \
    fi

# 复制应用代码
COPY . .

# 暴露端口
EXPOSE 8000

# 启动命令
CMD ["./venv/bin/uvicorn", "docker_main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
